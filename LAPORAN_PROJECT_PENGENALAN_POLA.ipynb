    "# PENGUJIAN & INSPEKSI DATASET FISIK\n",
    "import os\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Path direktori dataset\n",
    "DATASET_DIR = Path(\"ternaklele/dataset/fish_disease\")\n",
    "classes = [\"Sehat\", \"Aeromonas\", \"Parasit\", \"Jamur\", \"Overfeeding\"]\n",
    "\n",
    "data_counts = {}\n",
    "for cls in classes:\n",
    "    p = DATASET_DIR / cls\n",
    "    if p.exists():\n",
    "        data_counts[cls] = len(list(p.glob(\"*.jpg\")) + list(p.glob(\"*.png\")))\n",
    "    else:\n",
    "        data_counts[cls] = 0\n",
    "\n",
    "df_dist = pd.DataFrame(list(data_counts.items()), columns=[\"Kategori Kelas\", \"Jumlah Citra Terkurasi\"])\n",
    "total_samples = df_dist[\"Jumlah Citra Terkurasi\"].sum()\n",
    "df_dist[\"Proporsi (%)\"] = (df_dist[\"Jumlah Citra Terkurasi\"] / total_samples * 100).round(2)\n",
    "\n",
    "print(f\"=== RINGKASAN DISTRIBUSI DATASET (TOTAL: {total_samples} CITRA) ===\")\n",
    "display(df_dist)\n",
    "\n",
    "# Plot Visualisasi Distribusi Kelas\n",
    "plt.figure(figsize=(9, 4.5))\n",
    "palette = [\"#10b981\", \"#ef4444\", \"#3b82f6\", \"#8b5cf6\", \"#f59e0b\"]\n",
    "bars = plt.bar(df_dist[\"Kategori Kelas\"], df_dist[\"Jumlah Citra Terkurasi\"], color=palette, edgecolor=\"#333\", width=0.55)\n",
    "plt.title(\"Distribusi Jumlah Sampel per Kategori Kelas Penyakit Lele\", fontsize=13, fontweight=\"bold\", pad=12)\n",
    "plt.xlabel(\"Kelas Kondisi Lele\", fontsize=11, labelpad=8)\n",
    "plt.ylabel(\"Jumlah Citra\", fontsize=11, labelpad=8)\n",
    "plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "for bar in bars:\n",
    "    yval = bar.get_height()\n",
    "    plt.text(bar.get_x() + bar.get_width()/2.0, yval + 10, f\"{yval} ({yval/total_samples*100:.1f}%)\", ha=\"center\", va=\"bottom\", fontsize=10, fontweight=\"bold\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
