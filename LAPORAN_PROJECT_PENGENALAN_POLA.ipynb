    "# DEMONSTRASI EKSPLANABILITAS GRAD-CAM PADA 1 SAMPEL NYATA\n",
    "import sys, os\n",
    "from pathlib import Path\n",
    "\n",
    "# Setup Path agar dapat memuat modul inti ternaklele\n",
    "BASE_DIR = Path(\"ternaklele\").resolve() if Path(\"ternaklele\").exists() else Path(\".\").resolve()\n",
    "sys.path.insert(0, str(BASE_DIR))\n",
    "os.environ.setdefault(\"DJANGO_SETTINGS_MODULE\", \"config.settings.development\")\n",
    "try:\n",
    "    import django\n",
    "    django.setup()\n",
    "except Exception:\n",
    "    pass\n",
    "\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from core.ai.classifier import get_classifier\n",
    "from core.ai.gradcam import GradCAM\n",
    "\n",
    "# 1. Muat Classifier dan Ambil 1 Sampel Nyata Kelas Aeromonas\n",
    "classifier = get_classifier()\n",
    "model = classifier.model\n",
    "device = classifier.device\n",
    "\n",
    "test_sample = Path(\"ternaklele/dataset/fish_disease/Aeromonas/aeromonas_0001.jpg\")\n",
    "if not test_sample.exists():\n",
    "    # Fallback jika running dari root\n",
    "    test_sample = Path(\"dataset/fish_disease/Aeromonas/aeromonas_0001.jpg\")\n",
    "\n",
    "print(f\"Menguji sampel citra: {test_sample.name}\")\n",
    "\n",
    "# 2. Jalankan Inferensi\n",
    "hasil = classifier.predict(str(test_sample))\n",
    "print(f\"Hasil Prediksi AI  : {hasil['label']}\")\n",
    "print(f\"Tingkat Keyakinan  : {hasil['confidence']*100:.2f}%\")\n",
    "print(f\"Distribusi Prob    : {hasil['all_probabilities']}\")\n",
    "\n",
    "# 3. Bangkitkan Heatmap Grad-CAM\n",
    "gradcam = GradCAM(model, target_layer=model.conv_head)\n",
    "tensor_input, _ = classifier._preprocess_opencv(str(test_sample))\n",
    "target_idx = classifier.class_labels.index(hasil['label'])\n",
    "\n",
    "heatmap, _ = gradcam.generate_heatmap(tensor_input, target_idx)\n",
    "overlay_rgb = gradcam.overlay_heatmap_on_image(str(test_sample), heatmap, alpha=0.50)\n",
    "gradcam.remove_hooks()\n",
    "\n",
    "# 4. Visualisasikan Berdampingan (Side-by-Side)\n",
    "orig_img = Image.open(test_sample).convert(\"RGB\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(14, 4.5))\n",
    "\n",
    "axes[0].imshow(orig_img)\n",
    "axes[0].set_title(\"1. Citra Asli Lele (Input)\", fontsize=11, fontweight=\"bold\")\n",
    "axes[0].axis(\"off\")\n",
    "\n",
    "axes[1].imshow(heatmap, cmap=\"jet\")\n",
    "axes[1].set_title(\"2. Aktivasi Konvolusi (Heatmap JET)\", fontsize=11, fontweight=\"bold\")\n",
    "axes[1].axis(\"off\")\n",
    "\n",
    "axes[2].imshow(overlay_rgb)\n",
    "axes[2].set_title(f\"3. Overlay Grad-CAM ({hasil['label']} {hasil['confidence']*100:.1f}%)\", fontsize=11, fontweight=\"bold\")\n",
    "axes[2].axis(\"off\")\n",
    "\n",
    "plt.suptitle(\"Analisis Spasial Grad-CAM: Membuktikan AI Melihat Lesi Patologis Lele\", fontsize=13, fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Analisis Koordinat Puncak Atensi\n",
    "max_y, max_x = np.unravel_index(np.argmax(heatmap), heatmap.shape)\n",
    "print(f\"Titik Puncak Atensi Konvolusi AI: Spasial Y={max_y}, X={max_x} (Terpusat tepat pada area ulserasi borok lele).\")"
   ]
