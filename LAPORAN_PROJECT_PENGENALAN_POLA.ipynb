    "cm = np.array([\n",
    "    [24,  0,  0,  1,  0],  # Sehat\n",
    "    [ 1, 48,  0,  1,  0],  # Aeromonas\n",
    "    [ 0,  0, 25,  0,  0],  # Parasit\n",
    "    [ 0,  2,  0, 23,  0],  # Jamur\n",
    "    [ 0,  0,  0,  0,  4],  # Overfeeding\n",
    "])\n",
    "\n",
    "labels = [\"Sehat\", \"Aeromonas\", \"Parasit\", \"Jamur\", \"Overfeeding\"]\n",
    "\n",
    "plt.figure(figsize=(7.5, 6))\n",
    "sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", cbar=True,\n",
    "            xticklabels=labels, yticklabels=labels,\n",
    "            annot_kws={\"size\": 13, \"weight\": \"bold\"}, linewidths=1.2, linecolor=\"#ddd\")\n",
    "\n",
    "plt.title(\"Confusion Matrix Uji Buta Independen (129 Citra Murni)\\nAkurasi Total: 96.12% (124/129)\", fontsize=13, fontweight=\"bold\", pad=15)\n",
    "plt.xlabel(\"Label Prediksi AI\", fontsize=11, fontweight=\"bold\", labelpad=10)\n",
    "plt.ylabel(\"Label Aktual (Klinis)\", fontsize=11, fontweight=\"bold\", labelpad=10)\n",
    "plt.tight_layout()\n",
    "plt.show()"
